generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  price       Int
  category    String
  origin      String
  description String
  material    String?
  dimensions  String?
  care        String?
  badge       String?
  images      String[] // Native Postgres String Array
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())

  orders OrderItem[]
}

model Order {
  id                  String      @id @default(cuid())
  razorpayOrderId     String      @unique
  razorpayPaymentId   String      @unique
  amountINR           Int
  status              String      @default("paid")
  items               OrderItem[]
  createdAt           DateTime    @default(now())
}

model OrderItem {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId],   references: [id], onDelete: Cascade)
  orderId    String
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId  String
  name       String
  price      Int
  quantity   Int
}



model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now())
}