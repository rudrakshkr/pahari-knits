generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  price       Int
  category    String
  origin      String
  description String
  material    String?
  dimensions  String?
  care        String?
  badge       String?
  images      String[] // Native Postgres String Array
  inStock     Boolean  @default(true)
  maxQuantity Int?
  createdAt   DateTime @default(now())

  orders OrderItem[]
}

model Order {
  id                String      @id @default(cuid())
  razorpayOrderId   String      @unique
  razorpayPaymentId String      @unique
  amountINR         Int
  status            String      @default("paid")
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  deliveredAt       DateTime?
  returnRequest     Return?

  shippingName   String?
  shippingPhone  String?
  shippingEmail  String?
  shippingStreet String?
  shippingCity   String?
  shippingState  String?
  shippingPin    String?
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId String
  name      String
  price     Int
  quantity  Int
}

model Return {
  id              String    @id @default(cuid())
  orderId         String    @unique
  reason          String?
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  receivedAt      DateTime?
  refundedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  items           String[]

  order Order @relation(fields: [orderId], references: [id])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now())
}

model Feedback {
  id           String   @id @default(cuid())
  rating       Int
  message      String?
  productId    String   @unique
  customerName String
  createdAt    DateTime @default(now())
}
