generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  price       Int
  category    String
  origin      String
  description String
  material    String?
  dimensions  String?
  care        String?
  badge       String?
  images      String[] // Native Postgres String Array
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Order {
  id                String   @id @default(cuid())
  amount            Int
  status            String   @default("PENDING") 
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  createdAt         DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now())
}